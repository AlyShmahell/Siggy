FROM docker.io/library/golang:1.25-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends poppler-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY siggy/go.mod siggy/go.sum ./
COPY siggy/src ./src
COPY siggy/prompts ./prompts
COPY tests/smoke /smoke

ENV CGO_ENABLED=0
RUN go mod download

WORKDIR /src
ENTRYPOINT ["/bin/bash"]
