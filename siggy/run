#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../toolchains/menu.sh
source "$ROOT/toolchains/menu.sh"

export SIGGY_WORKSPACE="${SIGGY_WORKSPACE:-$ROOT/workspace}"
export SIGGY_HOME="${SIGGY_HOME:-$HOME/.siggy}"
mkdir -p "$SIGGY_HOME"

compose() {
  (cd "$ROOT/siggy" && podman compose -f compose.yaml "$@")
}

ensure_images() {
  (cd "$ROOT/toolchains" && podman compose -f compose.yaml pull)
}

cmd_build() {
  ensure_images
  compose build siggy
}

clipboard_run_args() {
  local args=()
  if [[ -n "${DISPLAY:-}" ]]; then
    args+=(-e "DISPLAY=$DISPLAY")
  fi
  if [[ -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" && -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]]; then
    args+=(-e "WAYLAND_DISPLAY=$WAYLAND_DISPLAY")
    args+=(-e "XDG_RUNTIME_DIR=/tmp")
    args+=(-v "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY:/tmp/$WAYLAND_DISPLAY:ro")
  fi
  if [[ -n "${XAUTHORITY:-}" && -f "$XAUTHORITY" ]]; then
    args+=(-e "XAUTHORITY=/tmp/xauthority")
    args+=(-v "$XAUTHORITY:/tmp/xauthority:ro")
  fi
  if ((${#args[@]} > 0)); then
    printf '%s\n' "${args[@]}"
  fi
}

cmd_tui() {
  cmd_build
  local extra=()
  mapfile -t extra < <(clipboard_run_args)
  compose run --rm "${extra[@]}" siggy
}

cmd_headless() {
  local prompt="${MENU_ARGS[*]:-}"
  if [[ -z "$prompt" ]]; then
    if [[ -t 0 ]]; then
      printf 'prompt> '
      IFS= read -r prompt
    else
      printf 'usage: ./run -- "Run headless" -- "<prompt>"\n' >&2
      return 2
    fi
  fi
  cmd_build
  compose run --rm siggy -p "$prompt"
}

cmd_shell() {
  cmd_build
  local extra=()
  mapfile -t extra < <(clipboard_run_args)
  compose run --rm --entrypoint /bin/bash "${extra[@]}" siggy
}

cmd_down() {
  compose down --remove-orphans || true
}

menu_parse_cli "$@"
menu_run "siggy  ·  podman" \
  "Build:cmd_build" \
  "Run TUI:cmd_tui" \
  "Run headless:cmd_headless" \
  "Shell:cmd_shell" \
  "Down:cmd_down"
